{
  "wica": {
    "agent": {
      "provider": "huggingface-hub",
      "model": "openai/gpt-oss-120b",
      "hf_provider": "cerebras",
      "system_prompt_file": "computer.md",
      "context_window": 128000,
      "history_budget": 0.5
    }
  },
  "asr": {
    "module": {
      "type": "mlx-audio",
      "model": "mlx-community/parakeet-tdt-0.6b-v3",
      "interim_interval_s": 0.5
    },
    "vad": {
      "type": "silero",
      "min_silence_duration_ms": 300
    }
  },
  "tts": {
    "module": {
      "type": "phonon",
      "voice": "Miles"
    }
  },
  "audio_processing": {
    "echo_cancellation": {
      "enabled": true,
      "stream_delay_ms": 50
    },
    "noise_suppression": {
      "enabled": false,
      "level": 2
    }
  },
  "vision": {
    "enabled": true,
    "threshold": 0.65,
    "fps": 10,
    "max_hands": 2,
    "hold_s": 0.3,
    "release_hold_s": 0.5,
    "device": null
  },
  "camera": {
    "device": 0
  }
}

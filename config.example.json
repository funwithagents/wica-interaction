{
  "wica": {
    "agent": {
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "api_key_env": "WICA_ANTHROPIC_API_KEY",
      "system_prompt_file": "prompts/assistant.md"
    }
  },
  "asr": {
    "engine": {
      "module": {
        "type": "deepgram_v2",
        "api_key_env": "DEEPGRAM_API_KEY",
        "model": "flux-general-en"
      },
      "audio": { "device": null },
      "dictation_default_segmentation_mode": "trigger_word"
    }
  },
  "reachy": {
    "backend": "sim",
    "robot": {},
    "daemon": {
      "spawn": "auto",
      "headless": false,
      "scene": null,
      "camera": {
        "source": "webcam",
        "device": null,
        "hfov_deg": 70.0
      },
      "preload_datasets": true,
      "startup_timeout": 45.0
    },
    "tts": {
      "module": {
        "type": "elevenlabs",
        "api_key_env": "ELEVENLABS_API_KEY",
        "voice_id": "JBFqnCBsd6RMkjVDRZzb",
        "model": "eleven_flash_v2_5"
      }
    },
    "audio": { "xvf3800": null },
    "motion": {
      "presence": true,
      "breathing": true,
      "wobbling": true,
      "tracking": true }
  },
  "vision": {
    "enabled": true,
    "threshold": 0.55,
    "fps": 5,
    "max_hands": 2,
    "device": null }
}

{
  "wica": {
    "agent": {
      "provider": "anthropic",
      "model": "claude-haiku-5-5",
      "api_key_env": "WICA_ANTHROPIC_API_KEY",
      "system_prompt_file": "../../prompts/reachy.md"
    }
  },
  "asr": {
    "engine": {
      "module": {
        "type": "deepgram_v2",
        "api_key_env": "DEEPGRAM_API_KEY",
        "model": "flux-general-en"
      },
      "audio": { "device": null },
      "dictation_default_segmentation_mode": "trigger_word"
    }
  },
  "reachy": {
    "backend": "sim",
    "robot": {},
    "tts": {
      "module": { "type": "phonon", "voice": "Micah" }
    },
    "audio": { "xvf3800": null },
    "face_detection": { "detector": "yunet", "enabled": true, "width": 640, "target_fps": null },
    "motion": {
      "presence": true,
      "idle": "breathing",
      "wobbling": true,
      "tracking": { "enabled": false }
    }
  },
  "vision": {
    "enabled": true,
    "threshold": 0.55,
    "fps": 5,
    "max_hands": 2,
    "hold_s": 0.5,
    "device": null
  }
}

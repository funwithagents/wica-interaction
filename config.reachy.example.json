{
  "wica": {
    "agent": {
      "provider": "huggingface-hub",
      "model": "openai/gpt-oss-120b",
      "hf_provider": "cerebras",
      "api_key_env": "WICA_HF_TOKEN",
      "system_prompt_file": "prompts/reachy.md",
      "context_window" : 128000,
      "history_budget" : 0.5
    }
  },
  "asr": {
    "engine": {
      "module": {
        "type": "deepgram-v2",
        "api_key_env": "DEEPGRAM_API_KEY",
        "model": "flux-general-en"
      },
      "audio_source": { "type": "custom" },
      "dictation_default_segmentation_mode": "trigger_word",
      "vad": { "type": "silero", "min_silence_duration_ms": 1500 }
    }
  },
  "vision": {
    "enabled": true,
    "threshold": 0.55,
    "fps": 10,
    "max_hands": 2,
    "hold_s": 0.3,
    "release_hold_s": 0.5,
    "device": null
  },
  "reachy": {
    "backend": "sim",
    "robot": {},
    "daemon": {
      "spawn": "auto",
      "headless": false,
      "scene": null,
      "camera": {
        "source": "webcam",
        "device": null,
        "hfov_deg": 70.0
      },
      "sim_displays": {
        "camera_overlay": true,
        "robot_gaze": true,
        "face_markers": true
      },
      "preload_datasets": true,
      "startup_timeout": 45.0
    },
    "tts": {
      "module": {
        "type": "pocket",
        "voice": "george",
        "device": "auto"
      }
    },
    "audio": { "xvf3800": null },
    "face_detection": {
      "detector": "yunet",
      "enabled": true,
      "width": 640,
      "score_threshold": 0.6,
      "target_fps": null
    },
    "motion": {
      "presence": true,
      "idle": "breathing",
      "wobbling": true,
      "tracking": {
        "enabled": false,
        "focus": false,
        "mirroring": {
          "enabled": true,
          "gain": 1.0,
          "max_deg": 20.0
        },
        "approach": {
          "enabled": true,
          "lean_mm": 15.0
        },
        "personal_space": {
          "enabled": true,
          "distance_m": 0.3,
          "max_back_mm": 20.0,
          "span_m": 0.1,
          "exit_margin_m": 0.1
        },
        "frame_delay_s": 0.0
      },
      "base_following": {
        "enabled": true,
        "deadband_deg": 20.0,
        "hold_s": 20.0,
        "lag_s": 0.8
      },
      "max_tilt_deg": 25.0
    }
  }
}

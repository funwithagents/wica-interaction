{
  "wica": {
    "agent": {
      "provider": "huggingface-hub",
      "model": "openai/gpt-oss-120b",
      "hf_provider": "cerebras",
      "api_key_env": "WICA_HF_TOKEN",
      "system_prompt_file": "prompts/reachy.md",
      "context_window": 128000,
      "history_budget": 0.5
    }
  },
  "asr": {
    "engine": {
      "module": {
        "type": "mlx-audio",
        "model": "mlx-community/parakeet-tdt-0.6b-v3",
        "interim_interval_s": 0.5
      },
      "vad": {
        "type": "silero",
        "min_silence_duration_ms": 300
      }
    }
  },
  "vision": {
    "enabled": true,
    "threshold": 0.65,
    "fps": 10,
    "max_hands": 2,
    "hold_s": 0.3,
    "release_hold_s": 0.5,
    "device": null
  },
  "reachy": {
    "backend": "sim",
    "daemon": {
      "spawn": "auto",
      "headless": false,
      "camera": {
        "source": "webcam",
        "device": null,
        "hfov_deg": 70.0
      },
      "sim_displays": {
        "camera_overlay": true,
        "robot_gaze": true,
        "face_markers": true
      }
    },
    "tts": {
      "module": {
        "type": "phonon",
        "voice": "Micah"
      }
    },
    "face_detection": {
      "detector": "yunet",
      "enabled": true,
      "width": 1280,
      "score_threshold": 0.6,
      "target_fps": null
    },
    "motion": {
      "presence": true,
      "wobbling": true,
      "tracking": {
        "enabled": false,
        "mirroring": {
          "enabled": true
        },
        "approach": {
          "enabled": true
        },
        "personal_space": {
          "enabled": true,
          "distance_m": 0.3,
          "span_m": 0.1,
          "exit_margin_m": 0.1
        }
      },
      "base_following": {
        "enabled": true
      }
    }
  }
}

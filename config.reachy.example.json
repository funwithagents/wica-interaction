{
  "wica": {
    "agent": {
      "provider": "huggingface-hub",
      "model": "openai/gpt-oss-120b",
      "hf_provider": "cerebras",
      "api_key_env": "WICA_HF_TOKEN",
      "system_prompt_file": "prompts/reachy.md",
      "context_window" : 128000,
      "history_budget" : 0.5
    }
  },
  "asr": {
    "engine": {
      "module": {
        "type": "deepgram_v2",
        "api_key_env": "DEEPGRAM_API_KEY",
        "model": "flux-general-en"
      },
      "audio": { "device": null },
      "dictation_default_segmentation_mode": "trigger_word"
    }
  },
  "reachy": {
    "backend": "sim",
    "robot": {},
    "daemon": {
      "spawn": "auto",
      "headless": false,
      "scene": null,
      "camera": {
        "source": "webcam",
        "device": null,
        "hfov_deg": 70.0
      },
      "sim_displays": {
        "camera_overlay": true
      },
      "preload_datasets": true,
      "startup_timeout": 45.0
    },
    "tts": {
      "module": {
        "type": "pocket",
        "voice": "george",
        "device": "auto"
      }
    },
    "audio": { "xvf3800": null },
    "face_detection": {
      "detector": "yunet",
      "enabled": true,
      "width": 640,
      "target_fps": null
    },
    "motion": {
      "presence": true,
      "idle": "breathing",
      "wobbling": true,
      "tracking": true }
  },
  "vision": {
    "enabled": true,
    "threshold": 0.55,
    "fps": 5,
    "max_hands": 2,
    "hold_s": 0.5,
    "device": null }
}
